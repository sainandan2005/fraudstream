# Copy to .env to override defaults. Works for BOTH docker compose and local
# (non-Docker) runs via pydantic-settings. The compose file pins the three
# infra endpoints to container DNS names, so at runtime only the tunables
# below take effect there, the endpoint lines matter for bare-metal runs.

# --- infrastructure endpoints ---
KAFKA_BOOTSTRAP_SERVERS=kafka:29092      # host runs: localhost:9092
REDIS_URL=redis://redis:6379/0           # host runs: redis://localhost:6379/0
DATABASE_URL=postgresql://fraud:fraud@postgres:5432/fraudstream   # host runs: ...@localhost:5433/...

# --- generator ---
TXN_RATE_PER_SEC=20          # transactions per second
FRAUD_RATIO=0.05             # fraction of ticks that plant a fraud pattern

# --- detector thresholds (risk score >= ALERT_THRESHOLD raises an alert) ---
ALERT_THRESHOLD=70
AMOUNT_LIMIT=100000          # ₹ per single txn
VELOCITY_COUNT_MAX=5         # txns per card...
VELOCITY_COUNT_WINDOW_SEC=300   # ...within this many seconds
VELOCITY_SUM_CAP=250000      # ₹ spent per card...
VELOCITY_SUM_WINDOW_SEC=600  # ...within this many seconds
USER_VELOCITY_MAX=12         # txns across all of a user's cards
USER_VELOCITY_WINDOW_SEC=600
ANOMALY_MIN_SAMPLES=20       # card history needed before z-score rule arms
ANOMALY_SIGMA_MULT=4         # amount must exceed mean + N sigma
GEO_SPEED_KMH_MAX=900        # implied travel speed limit

# --- ml-scorer ---
MODEL_PATH=/app/models/model.pkl   # missing file -> heuristic-v0 fallback

# --- alerts-api ---
API_HOST=0.0.0.0
API_PORT=8000
